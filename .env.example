# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# 대본 생성 (작업 D)
ANTHROPIC_API_KEY=
SHORTFORM_SCRIPT_MODEL=claude-sonnet-5-5

# 음성 (작업 E): auto | google | edge | elevenlabs
#   auto = GOOGLE_TTS_API_KEY 가 있으면 google(Chirp 3 HD), 없으면 edge(무료, 시험용)
SHORTFORM_TTS_PROVIDER=auto
#   비우면 제공자별 기본값 (google: ko-KR-Chirp3-HD-Aoede, edge: ko-KR-SunHiNeural)
#   elevenlabs 는 목소리 ID 를 꼭 넣어야 해요
SHORTFORM_TTS_VOICE=
#   말 속도 배율, 영상이 55초를 넘으면 1.1 정도로
SHORTFORM_TTS_RATE=1.0
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# 이미지 (작업 F)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 업로드 (작업 H): Google Cloud 에서 받은 OAuth 클라이언트 파일 경로
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# 결과물 폴더
SHORTFORM_OUTPUT_DIR=output
