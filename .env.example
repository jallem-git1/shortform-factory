# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# 대본 생성 (작업 D)
ANTHROPIC_API_KEY=
SHORTFORM_SCRIPT_MODEL=claude-sonnet-5-5
# 주제 다듬기는 가벼운 일이라 Haiku
SHORTFORM_TOPIC_MODEL=claude-haiku-5-5

# 음성 (작업 E): edge(무료) | google | elevenlabs
SHORTFORM_TTS_PROVIDER=edge
SHORTFORM_TTS_VOICE=ko-KR-SunHiNeural
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# 이미지 (작업 F)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 업로드 (작업 H): Google Cloud 에서 받은 OAuth 클라이언트 파일 경로
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# 결과물 폴더
SHORTFORM_OUTPUT_DIR=output
